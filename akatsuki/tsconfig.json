{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"allowJs": true
	},
	"include": [
		"../apps/meteor/client/akatsuki/core.ts",
		"../apps/meteor/client/akatsuki/storage.ts",
		"../apps/meteor/client/akatsuki/model.ts",
		"tests/**/*.test.ts",
		"vitest.config.ts"
	]
}
